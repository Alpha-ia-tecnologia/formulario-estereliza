# ---- Formulário (lido no build: rode `npm run build` de novo ao alterar) ----

# E-mail que recebe os pacotes de respostas. Quando preenchido, a tela final
# mostra o botão "Abrir e-mail" já endereçado. Opcional.
VITE_DESTINATARIO_EMAIL=

# Endereço do servidor que guarda as respostas (sem /api no fim), só quando o
# formulário é hospedado em outro lugar ou aberto do disco. Servido pelo próprio
# `npm run server`, o app encontra a API sozinho. Opcional.
VITE_API_URL=

# ---- Servidor (`npm run server`) ----

# Porta em que o servidor escuta. Padrão: 8787.
PORT=8787

# Conexão com o PostgreSQL que guarda as respostas (obrigatória). A tabela é criada
# sozinha. No Easypanel, use a "Internal Connection URL" do serviço do banco.
DATABASE_URL=postgres://usuario:senha@localhost:5432/requisitos

# Token exigido para LER as respostas guardadas (Authorization: Bearer <token>).
# Sem ele, o servidor recebe respostas mas não permite consultá-las. Mínimo de
# 32 caracteres; gere um com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Tamanho máximo de cada pacote recebido, em MB. Padrão: 60.
MAX_UPLOAD_MB=60

# Tamanho máximo da tabela de respostas, em MB; acima disso novos envios são recusados. Padrão: 2048.
MAX_DB_MB=2048

# Atrás de um proxy reverso (nginx, Caddy…), 1 faz o limite de envios por IP usar
# o último endereço de X-Forwarded-For em vez do endereço do proxy.
TRUST_PROXY=0
